# Persistent MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=rebel_ink

# Long random secret, at least 32 characters
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# These are the ONLY admin credentials. They are not stored in index.html.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD_12CHARS_MIN

# Optional. The current frontend reset form will stay disabled unless this is set.
# For a proper customer password-recovery email flow, add an email provider later.
RESET_PASSWORD_KEY=OPTIONAL_SERVER_SIDE_RESET_KEY
